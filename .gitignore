!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Guard against accidental npm init at repo root
# The Next app lives in next/, so ignore only the root-level files
/package.json
/package-lock.json
