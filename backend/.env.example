## Backend environment configuration
# Copy this file to `.env` and fill in values.

# Option 1: MongoDB Atlas (recommended)
# Replace <username>, <password>, <cluster-host>, and <dbName>
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<dbName>?retryWrites=true&w=majority

# Option 2: Local MongoDB (running on your machine)
# MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Option 3: In-memory DB for development (no install needed)
# MONGODB_USE_MEMORY=true

# Port for the Express API
PORT=5000
