{
  "version": 2,
  "builds": [
    { "src": "next/next.config.js", "use": "@vercel/next" }
  ],
  "routes": [
    { "src": "/api/(.*)", "headers": { "Cache-Control": "no-store" }, "dest": "next/api/$1" },
    { "src": "/(.*)", "dest": "next/$1" }
  ],
  "functions": {
    "api/**": {
      "runtime": "nodejs20.x",
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
