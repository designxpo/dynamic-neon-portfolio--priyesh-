# Frontend env example
# If serving API from a different host in production, set this to that URL.
# Leave empty in local dev to use Vite dev proxy (see vite.config.ts).
# Examples:
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_API_BASE_URL=http://localhost:5000
VITE_API_BASE_URL=

# Optional: Gemini key if you use AI features
GEMINI_API_KEY=
