## Next.js app environment
# Copy this file to .env.local and fill values. Lines without values are examples.

# --- Database (optional but recommended) ---
# When provided, Admin content and contact submissions persist to MongoDB.
# If omitted, the app runs in local fallback mode (content stored in the browser),
# and the chatbot will use a client-provided snapshot for context.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/portfolio?retryWrites=true&w=majority

# --- Public client config (optional) ---
# NEXT_PUBLIC_API_BASE_URL=

# --- LLM Providers (choose ONE section to fill) ---

# OpenAI
# Docs: https://platform.openai.com
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
# Docs: https://learn.microsoft.com/azure/ai-services/openai/
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Google Gemini
# Docs: https://ai.google.dev
# Either GEMINI_API_KEY or GOOGLE_API_KEY works
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash-latest
